<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_welcome_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_enquete_pergunta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pergunta da Enquete"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_enquete_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Criado pelo Chefe de Turma"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Option A -->
        <TextView
            android:id="@+id/tv_opcao_1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_light"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="A) Terça-feira (10:00 - 12:00)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Option B -->
        <TextView
            android:id="@+id/tv_opcao_2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="B) Quinta-feira (14:00 - 16:00) [Votado]"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>